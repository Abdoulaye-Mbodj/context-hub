# Port expose par Docker Desktop
CONTEXT_HUB_PORT=8080

# URL publique utilisee dans les liens profonds et les integrations
APP_PUBLIC_URL=http://localhost:8080

# A remplacer sur un VPS
POSTGRES_PASSWORD=change-me-with-a-long-random-password

# false en production
DEMO_MODE=true

# Origines separees par des virgules
CORS_ORIGINS=http://localhost:8080

# Facultatif : protege les appels entrants des connecteurs generiques
INTEGRATION_API_KEY=

# Facultatif : signe les webhooks Odoo en HMAC SHA-256
ODOO_WEBHOOK_SECRET=

# Chiffre les identifiants OAuth et les clés API en base.
# Utiliser au moins 32 caractères aléatoires et ne plus changer après configuration.
APP_SECRET_KEY=change-me-with-a-long-random-encryption-secret

# Navigateur Chromium rendu dans Context Hub
EMBEDDED_BROWSER_ENABLED=true
CONTEXT_BROWSER_PORT=3000
EMBEDDED_BROWSER_PUBLIC_URL=http://localhost:3000
# Facultatif en local. En production, protéger tout le domaine avec le SSO.
CONTEXT_BROWSER_USER=context-hub
CONTEXT_BROWSER_PASSWORD=
