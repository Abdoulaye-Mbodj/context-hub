<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="crm_lead_view_form_context_hub" model="ir.ui.view">
    <field name="name">crm.lead.form.context.hub</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_context_hub" type="object" string="Context Hub" class="btn-secondary" icon="fa-link"/>
      </xpath>
    </field>
  </record>

  <record id="res_partner_view_form_context_hub" model="ir.ui.view">
    <field name="name">res.partner.form.context.hub</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_context_hub" type="object" class="oe_stat_button" icon="fa-link">
          <div class="o_stat_info"><span class="o_stat_text">Context Hub</span></div>
        </button>
      </xpath>
    </field>
  </record>

  <record id="project_project_view_form_context_hub" model="ir.ui.view">
    <field name="name">project.project.form.context.hub</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_context_hub" type="object" class="oe_stat_button" icon="fa-link">
          <div class="o_stat_info"><span class="o_stat_text">Context Hub</span></div>
        </button>
      </xpath>
    </field>
  </record>

  <record id="project_task_view_form_context_hub" model="ir.ui.view">
    <field name="name">project.task.form.context.hub</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_context_hub" type="object" string="Context Hub" class="btn-secondary" icon="fa-link"/>
      </xpath>
    </field>
  </record>
</odoo>
